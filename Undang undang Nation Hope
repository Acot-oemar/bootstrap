<!-- HASIL -->
<div class="hasil">
  <h3>Hasil Perhitungan:</h3>
  <p>Total Denda: <strong id="totalDenda">0</strong></p>
  <p>Hukuman Penjara Maksimal: <strong id="totalPenjara">0</strong> tahun</p>
</div>

<script>
const boxes = document.querySelectorAll('input[type="checkbox"]');
const totalDenda = document.getElementById('totalDenda');
const totalPenjara = document.getElementById('totalPenjara');

boxes.forEach(b => b.addEventListener('change', hitung));

function hitung() {
  let denda = 0, maxPenjara = 0;
  boxes.forEach(b => {
    if (b.checked) {
      denda += parseInt(b.value) || 0;
      let penjara = parseInt(b.dataset.penjara);
      if (penjara > maxPenjara) maxPenjara = penjara;
    }
  });
  totalDenda.textContent = denda.toLocaleString();
  totalPenjara.textContent = (maxPenjara >= 999 ? 'Hukuman Mati' : maxPenjara);
}
</script>

